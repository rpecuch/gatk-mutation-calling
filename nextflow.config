docker.enabled = true

params {
    ref = 'data/ref_genome/hg38.fa.gz'
    scripts = 'src/scripts'
    outdir = 'data/outputs'
    reads = 'data/reads'
}

// Output configuration
outputDir = params.outdir
workflow.output.mode = 'copy'

// Execution settings
process {
    cpus = 2
    memory = 4.GB

    // Run conservatively
    maxForks = 1
}