docker.enabled = true

params {
    ref = 'data/ref_genome/hg38.fa.gz'
    scripts = 'src/scripts'
    outdir = 'data/outputs'
    reads = 'data/reads'
    snp_filters = 'QD < 2.0 || FS > 60.0 || MQ < 40.0 || SOR > 3.0'
}

// Output configuration
outputDir = params.outdir
workflow.output.mode = 'copy'

// Execution settings
process {
    cpus = 2
    memory = 4.GB

    // Run conservatively
    maxForks = 1
}