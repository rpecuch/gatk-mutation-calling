// Default parameter values
params {
    ref = 'data/ref_genome/hg38.fa.gz'
    scripts = 'src/scripts'
    outdir = 'data/outputs'
    reads = 'data/reads'
    snp_filters = 'QD < 2.0 || FS > 60.0 || MQ < 40.0 || SOR > 3.0'
}

// Output configuration
outputDir = params.outdir
workflow.output.mode = 'copy'

// Execution settings
process {
    cpus = 4
    memory = 6.GB

    // Run conservatively
    maxForks = 1

    // Conda enviornment
    conda = '/opt/miniconda3/envs/mutation-calling'
}

// Execution profiles
profiles {
    conda {
        conda.enabled = true
    }

    docker {
        process.container = 'rpecuch/gatk-pipeline:v1.0'
        docker.enabled = true
    }
}
